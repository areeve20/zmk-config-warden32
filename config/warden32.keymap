#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    chosen { zmk,matrix-transform = &dual_1u_transform; };

    behaviors {
        // Tap: 1 | Double-tap: 7
        td_n1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N1>, <&kp N7>;
        };

        // Tap: 2 | Double-tap: 8
        td_n2: tap_dance_2 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N2>, <&kp N8>;
        };

        // Tap: 3 | Double-tap: 9
        td_n3: tap_dance_3 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N3>, <&kp N9>;
        };

        // Tap: 4 | Double-tap: 0
        td_n4: tap_dance_4 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N4>, <&kp N0>;
        };

        // Tap: 5 | Double-tap: Minus (-)
        td_n5: tap_dance_5 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N5>, <&kp MINUS>;
        };

        // Tap: 6 | Double-tap: Equal (=)
        td_n6: tap_dance_6 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp N6>, <&kp EQUAL>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "Base";
            bindings = <
&kp ESC    &td_n1    &td_n2    &td_n3     &td_n4     &td_n5     &td_n6
&kp TAB    &kp Q     &kp W     &kp E      &kp R      &kp T      &kp DEL
&kp CAPS   &kp A     &kp S     &kp D      &kp F      &kp G      &kp RET
&kp LSHFT  &kp Z     &kp X     &kp C      &kp V      &mo 2      &none
&kp LCTRL  &kp LGUI  &kp LALT  &kp SPACE  &mo 1      &none      &none
            >;
        };

        lower {
            display-name = "FN";
            bindings = <
&kp GRAVE  &kp F1    &kp F2    &kp F3     &kp F4     &kp F5     &kp BACKSPACE
&kp TAB    &kp Y     &kp U     &kp I      &kp O      &kp P      &kp BACKSLASH
&kp CAPS   &kp H     &kp J     &kp K      &kp L      &kp SEMI   &kp RET
&kp LSHFT  &kp B     &kp N     &kp M      &kp PERIOD &mo 2      &none
&kp LCTRL  &kp LGUI  &kp LALT  &kp SPACE  &mo 1      &none      &none
            >;
        };

        bluetooth {
            display-name = "Blue";
            bindings = <
&kp KP_N0  &kp F11       &kp F12       &kp F13       &none  &none  &bootloader
&none      &none         &kp UP        &none         &none  &none  &none
&none      &kp LEFT      &kp DOWN      &kp RIGHT     &none  &none  &none
&none      &none         &none         &none         &none  &none  &none
&bt BT_CLR &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &none  &none  &none
            >;
        };
    };
};
